# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5432/analyst
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
MAX_ROWS=2000000
QUERY_TIMEOUT_S=30
QUERY_MEMORY_MB=512
QUERY_THREADS=2
PROFILE_MEMORY_MB=512
ANALYSIS_MEMORY_MB=512
AUTO_ANALYZE=true
INGEST_STUCK_MINUTES=30
MLFLOW_TRACKING_URI=http://localhost:5000
# The MLflow server has no authentication: keep it on localhost only (see docs/known-limits.md).
MLFLOW_HTTP_REQUEST_TIMEOUT=3
MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
FORECAST_MAX_SECONDS=60
FORECAST_MAX_SERIES=11
FORECAST_MAX_HORIZON=24
FORECAST_MAX_GROUPS=10
# Process RSS guard. The worker alone peaks near 440 MB during a forecast (measured), so compose
# uses 600 inside its 768m limit (the built-in default is 400).
FORECAST_MEMORY_MB=600
FORECAST_SEED=42
# Step 6: anomalies and customer segments. Fixed seed for IsolationForest, KMeans and bootstraps.
ML_SEED=42
# Row-level anomaly checks train their Isolation Forest on at most this many rows (counts use all).
ANOMALY_ROW_SAMPLE=50000
# Time budgets: past them the work degrades with a warning (fewer methods/rounds), never times out.
ANOMALY_MAX_SECONDS=60
SEGMENT_MAX_SECONDS=60
# K-Means is fitted on at most this many customers; every customer is still assigned.
SEGMENT_MAX_CUSTOMERS=100000
SEGMENT_BOOTSTRAP_ROUNDS=20
# Step 7: churn risk and drivers. Churn models train on at most CHURN_MAX_CUSTOMERS customers per
# snapshot (fixed random sample); SHAP runs once per scored customer for its reasons and the global
# importance. Drivers fit on at most DRIVER_MAX_ROWS rows
# and explain DRIVER_SHAP_ROWS of them. Past the time budgets the work degrades with a warning.
CHURN_MAX_CUSTOMERS=200000
CHURN_MAX_SECONDS=60
DRIVER_MAX_ROWS=50000
DRIVER_SHAP_ROWS=2000
DRIVER_MAX_SECONDS=60
# What-if runs in the API process; at most this many requests per process open a DuckDB table at once.
WHATIF_MAX_CONCURRENT=2
# HMAC key for customer pseudonyms when the customer id column is personal data. Empty = derived
# from JWT_SECRET (a warning is logged at startup); set it separately in production, because
# changing JWT_SECRET would then change every pseudonym.
PSEUDONYM_SECRET=
CORS_ORIGINS=http://localhost:3000
EMAIL_PROVIDER=none
EMAIL_API_KEY=
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
