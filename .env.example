# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5432/analyst
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# development | test | production. LLM_PROVIDER=fake refuses to start when APP_ENV=production.
APP_ENV=development
# Step 8 agent. LLM_PROVIDER: deepseek (OpenAI-compatible API) | fake (scripted test model, no key,
# never in production) | none (agent off). Process environment variables override this file, so
# `LLM_PROVIDER=fake` in the shell wins over a deepseek value here.
LLM_PROVIDER=none
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# Main and cheap model (summaries, lookups) and the strong model for decision/why/what-if questions.
LLM_MODEL=deepseek-flash
LLM_MODEL_STRONG=deepseek-v4-pro
# enabled | disabled. DeepSeek turns thinking on by default; with tools the client replays reasoning.
LLM_THINKING=enabled
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=4096
# Approximate USD prices per million tokens (peak rates; check
# https://api-docs.deepseek.com/quick_start/pricing). Costs in the app are labelled approximate.
LLM_PRICE_INPUT_PER_M=0.44
LLM_PRICE_CACHED_INPUT_PER_M=0.014
LLM_PRICE_OUTPUT_PER_M=1.32
LLM_PRICE_STRONG_INPUT_PER_M=1.32
LLM_PRICE_STRONG_CACHED_INPUT_PER_M=0.044
LLM_PRICE_STRONG_OUTPUT_PER_M=3.96
# Tokens per tenant per UTC day (all models); past it the chat stream returns budget_exceeded.
AGENT_DAILY_TOKEN_BUDGET=200000
AGENT_MAX_ITERATIONS=8
# Messages sent as history; older ones are folded into a summary after AGENT_SUMMARY_AFTER messages.
AGENT_HISTORY_MESSAGES=12
AGENT_SUMMARY_AFTER=16
# Characters of each tool result shown to the model (full evidence is still stored).
AGENT_TOOL_OUTPUT_CHARS=12000
# Per-user limits on POST /chat/stream.
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_MAX_CONCURRENT_STREAMS=2
# run_python sandbox: unix socket on the sandbox-ipc volume (http://host:port also works).
SANDBOX_URL=unix:///ipc/sandbox.sock
SANDBOX_TIMEOUT_S=15
# Data sent to the sandbox per call; larger role-column data is sampled with a warning.
SANDBOX_MAX_UPLOAD_MB=20
# Address-space limit of each sandbox job (the container itself has 512m).
SANDBOX_CHILD_MEMORY_MB=400
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
MAX_ROWS=2000000
QUERY_TIMEOUT_S=30
QUERY_MEMORY_MB=512
QUERY_THREADS=2
PROFILE_MEMORY_MB=512
ANALYSIS_MEMORY_MB=512
AUTO_ANALYZE=true
INGEST_STUCK_MINUTES=30
MLFLOW_TRACKING_URI=http://localhost:5000
# The MLflow server has no authentication: keep it on localhost only (see docs/known-limits.md).
MLFLOW_HTTP_REQUEST_TIMEOUT=3
MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
FORECAST_MAX_SECONDS=60
FORECAST_MAX_SERIES=11
FORECAST_MAX_HORIZON=24
FORECAST_MAX_GROUPS=10
# Process RSS guard. The worker alone peaks near 440 MB during a forecast (measured), so compose
# uses 600 inside its 768m limit (the built-in default is 400).
FORECAST_MEMORY_MB=600
FORECAST_SEED=42
# Step 6: anomalies and customer segments. Fixed seed for IsolationForest, KMeans and bootstraps.
ML_SEED=42
# Row-level anomaly checks train their Isolation Forest on at most this many rows (counts use all).
ANOMALY_ROW_SAMPLE=50000
# Time budgets: past them the work degrades with a warning (fewer methods/rounds), never times out.
ANOMALY_MAX_SECONDS=60
SEGMENT_MAX_SECONDS=60
# K-Means is fitted on at most this many customers; every customer is still assigned.
SEGMENT_MAX_CUSTOMERS=100000
SEGMENT_BOOTSTRAP_ROUNDS=20
# Step 7: churn risk and drivers. Churn models train on at most CHURN_MAX_CUSTOMERS customers per
# snapshot (fixed random sample); SHAP runs once per scored customer for its reasons and the global
# importance. Drivers fit on at most DRIVER_MAX_ROWS rows
# and explain DRIVER_SHAP_ROWS of them. Past the time budgets the work degrades with a warning.
CHURN_MAX_CUSTOMERS=200000
CHURN_MAX_SECONDS=60
DRIVER_MAX_ROWS=50000
DRIVER_SHAP_ROWS=2000
DRIVER_MAX_SECONDS=60
# What-if runs in the API process; at most this many requests per process open a DuckDB table at once.
WHATIF_MAX_CONCURRENT=2
# Dashboard time series: most periods one request may return (a longer range needs a coarser grain).
# It shares the what-if concurrency limit above, because both open the same DuckDB table.
TIMESERIES_MAX_POINTS=1500
# Most rows one CSV export of the segment or churn customer table may contain.
EXPORT_MAX_ROWS=50000
# HMAC key for customer pseudonyms when the customer id column is personal data. Empty = derived
# from JWT_SECRET (a warning is logged at startup); set it separately in production, because
# changing JWT_SECRET would then change every pseudonym.
PSEUDONYM_SECRET=
CORS_ORIGINS=http://localhost:3000
EMAIL_PROVIDER=none
EMAIL_API_KEY=
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
